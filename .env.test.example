# =============================================================================
# ESCOPO ADMINISTRATIVO / TESTES - o unico lugar com credencial privilegiada
#
# Usado por:
#   - pnpm test:isolation  (cria e remove usuarios de teste)
#   - pnpm db:push         (aplica migrations)
#
# Copie para .env.test (ja ignorado pelo git) e preencha.
# NUNCA copie estes valores para apps/web/.env.local ou apps/api/.env.
# NUNCA comite o .env.test preenchido.
# =============================================================================

# Settings -> API -> Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Settings -> API -> anon / publishable key
SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Settings -> API -> service_role / secret key
# BYPASSA O RLS. Jamais no frontend, jamais no bundle, jamais no git.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# Settings -> Database -> Connection string (usada pelo supabase db push)
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# API local para os testes de nivel HTTP (pulados se estiver fora do ar)
API_URL=http://localhost:3333

{
  "name": "clinicas-saas",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS multi-clinica - fundacao v0.1 (auth, multi-tenancy, RLS)",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @clinicas/shared build",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck && tsc -p supabase/tsconfig.json",
    "test": "pnpm build:shared && vitest run --project shared --project api",
    "test:isolation": "pnpm build:shared && vitest run --project isolation",
    "test:isolation:cleanup": "node scripts/cleanup-test-run.mjs",
    "check:secrets": "node scripts/check-secret-boundaries.mjs",
    "verify:privileges": "node scripts/inspect-privileges.mjs",
    "db:preflight": "node scripts/db-push.mjs --check",
    "db:push": "node scripts/db-push.mjs",
    "db:push:raw": "supabase db push",
    "db:diff": "supabase db diff",
    "test:hint": "pnpm build:shared && vitest run --project hint",
    "test:atendimento": "pnpm build:shared && vitest run --project atendimento",
    "test:tasks": "pnpm build:shared && vitest run --project tasks",
    "verify:migrations": "node scripts/verify-migrations.mjs"
  },
  "devDependencies": {
    "@clinicas/config": "workspace:*",
    "@clinicas/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.7",
    "@supabase/supabase-js": "2.112.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "eslint": "10.9.1",
    "pg": "8.23.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}

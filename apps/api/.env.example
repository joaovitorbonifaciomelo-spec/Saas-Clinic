# =============================================================================
# apps/api - ESCOPO SERVIDOR DE APLICACAO
#
# Note o que NAO esta aqui: SUPABASE_SERVICE_ROLE_KEY e SUPABASE_DB_URL.
# A API fala com o Postgres usando a anon key + o JWT do usuario da requisicao,
# entao o RLS continua valendo. Se ela tivesse a service_role, um unico
# esquecimento passaria por cima de todo o isolamento entre clinicas.
# =============================================================================

NODE_ENV=development
API_PORT=3333

# Settings -> API -> Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Settings -> API -> anon / publishable key (a MESMA do frontend)
SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Origem permitida no CORS
WEB_ORIGIN=http://localhost:3000

# =============================================================================
# apps/web - ESCOPO PUBLICO
#
# Tudo com prefixo NEXT_PUBLIC_ e embutido no bundle enviado ao navegador.
# NUNCA coloque service_role, senha de banco ou qualquer segredo neste arquivo.
# A anon key e publica por design: sozinha ela nao abre nada, quem decide o que
# ela enxerga e o RLS no Postgres.
# =============================================================================

# Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Settings -> API -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Onde a API NestJS responde
NEXT_PUBLIC_API_URL=http://localhost:3333
